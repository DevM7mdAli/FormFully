{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node --import tsx tooling/release/set-version.ts ${nextRelease.version} && pnpm package:extension"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["apps/extension/manifest.base.json", "apps/extension/package.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\\n\\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": ["artifacts/*.zip", "artifacts/*.zip.sha256"]
      }
    ]
  ]
}
