{
  "name": "formfully",
  "description": "FormFully browser extension and landing page, managed as an Nx + pnpm monorepo.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevM7mdAli/FormFully.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev:landing": "nx run landing-page:serve",
    "dev:extension": "nx run extension:serve",
    "dev:extension:chrome": "nx run extension:serve:chrome",
    "dev:extension:firefox": "nx run extension:serve:firefox",
    "dev:extension:safari": "nx run extension:serve:safari",
    "build": "nx run-many -t build",
    "build:extension": "nx run extension:build",
    "build:landing": "nx run landing-page:build",
    "build:sites": "nx run landing-page:build-sites",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "lint:firefox": "nx run extension:lint",
    "test": "nx run-many -t test",
    "verify": "nx run-many -t typecheck lint test build",
    "check": "nx run-many -t typecheck lint test build package",
    "affected": "nx affected -t typecheck lint test build",
    "package:extension": "nx run extension:package",
    "graph": "nx graph",
    "nx:reset": "nx reset",
    "prepare": "husky",
    "commitlint": "commitlint --last --verbose",
    "release": "semantic-release",
    "publish:chrome": "node --import tsx tooling/release/publish-stores.ts --store chrome",
    "publish:edge": "node --import tsx tooling/release/publish-stores.ts --store edge"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.12.3",
    "husky": "^9.1.7",
    "nx": "24.0.2",
    "semantic-release": "^25.0.8",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "web-ext": "^10.5.0"
  }
}
