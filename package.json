{
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./src/output.css",
    "package:extension": "npm run build:css && node scripts/package-extension.mjs",
    "publish:chrome": "node scripts/publish-stores.mjs --store chrome",
    "publish:edge": "node scripts/publish-stores.mjs --store edge",
    "tailwind": "tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "tailwindcss": "^3.4.1"
  },
  "packageManager": "pnpm@10.0.0+sha512.b8fef5494bd3fe4cbd4edabd0745df2ee5be3e4b0b8b08fa643aa3e4c6702ccc0f00d68fa8a8c9858a735a0032485a44990ed2810526c875e416f001b17df12b"
}
