{
  "manifest_version": 3,
  "name": "FormFully",
  "description": "Fill web forms in one click, with one value for every field or from a saved profile.",
  "version": "2.2.2",
  "homepage_url": "https://formfully.mohammed.win/",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "host_permissions": [
    "https://www.developer.chrome.com/*"
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "commands": {
    "fill-form": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Fill inputs using FormFully"
    },
    "fill-form-alt": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Option+Shift+F"
      },
      "description": "Fill inputs using FormFully (alternate)"
    }
  }
}
