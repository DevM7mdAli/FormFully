{
  "manifest_version": 3,
  "name": "FormFully",
  "description": "Fill forms instantly with the original one-value mode or smart profile-aware autofill.",
  "version": "2.2.0",
  "homepage_url": "https://mohammed-alajmi.me/FormFully/",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },

  "host_permissions": [
    "https://www.developer.chrome.com/*"
  ],
  
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "fill-form": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Fill inputs using FormFully"
    }
  }
}
